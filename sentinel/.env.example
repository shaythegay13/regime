# Sentinel environment variable template
# Copy this file to .env.local and set a real Atlas connection string.
# Never commit .env.local to source control.

# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://REPLACE_ME:REPLACE_ME@cluster0.example.mongodb.net/

# Database name (default: sentinel)
MONGODB_DATABASE=sentinel
